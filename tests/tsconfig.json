{
  "extends": "../packages/tsconfig/base.json",
  "compilerOptions": {
    "noEmit": true,
    "target": "ES2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "*": ["./../apps/api/node_modules/*", "./../node_modules/*"]
    },
    "rootDir": ".."
  },
  // 目标是把 tests/integration 也纳入；它当前还有 70 条待 triage
  // （38 条是 supertest 声明缺失，其余多为仓库级 strict 开关与既有的宽类型用法），
  // 所以先覆盖最容易漏传参数的 contract / tenant-isolation / e2e 三块。
  "include": ["contract/**/*.ts", "tenant-isolation/**/*.ts", "e2e/**/*.ts"]
}
