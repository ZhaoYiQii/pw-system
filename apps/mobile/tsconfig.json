{
  "extends": "../../packages/tsconfig/base.json",
  "compilerOptions": {
    "target": "es2017",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["es2017", "dom"],
    "jsx": "react-jsx",
    "noEmit": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "outDir": "lib",
    "rootDir": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@platform-runtime": ["./src/platform/h5/runtime.ts"],
      "@platform-locator": ["./src/platform/h5/tenant-locator.ts"],
      "@platform-runtime-config": ["./src/platform/h5/runtime-config.ts"],
      "@platform-identity": ["./src/platform/h5/identity-adapter.ts"],
      "@platform-session": ["./src/platform/h5/session-store.ts"],
      "@platform-api": ["./src/platform/h5/api-adapter.ts"],
      "@platform-media": ["./src/platform/h5/media-adapter.ts"]
    }
  },
  "include": ["./src", "./types", "./config"],
  "compileOnSave": false
}
