{
  "name": "@pw/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "openapi:document": "tsc -p tsconfig.build.json && node scripts/generate-openapi.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/background/bootstrap.js"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@pw/config-schema": "workspace:*",
    "@pw/database": "workspace:*",
    "ioredis": "^6.0.0",
    "jose": "6.2.12",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@nestjs/testing": "12.0.1",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2",
    "yaml": "2.9.0"
  }
}
