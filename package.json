{
  "name": "pw-saas",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "vitest run --config vitest.config.ts",
    "test:critical": "node scripts/not-implemented.mjs test:critical \"Slice 5+（订单/场次/结算状态机切片引入）\"",
    "test:integration": "node scripts/not-implemented.mjs test:integration \"Slice 1+（随 packages/database 引入）\"",
    "test:tenant-isolation": "node scripts/not-implemented.mjs test:tenant-isolation \"Slice 1（租户隔离）\"",
    "test:contract": "node scripts/not-implemented.mjs test:contract \"Slice 3+（OpenAPI 客户端契约）\"",
    "test:e2e": "node scripts/not-implemented.mjs test:e2e \"Slice 5+（Playwright E2E）\"",
    "build": "turbo run build",
    "build:h5": "turbo run build:h5",
    "build:weapp": "turbo run build:weapp",
    "openapi:generate": "node scripts/not-implemented.mjs openapi:generate \"Slice 1+（随 API 契约建立）\"",
    "openapi:check": "node scripts/not-implemented.mjs openapi:check \"Slice 1+\"",
    "db:migrate:check": "node scripts/not-implemented.mjs db:migrate:check \"Slice 1（packages/database）\"",
    "db:seed:test": "node scripts/not-implemented.mjs db:seed:test \"Slice 1\""
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@pw/eslint-config": "workspace:*",
    "@types/node": "24.13.3",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "turbo": "2.10.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "3.2.7"
  }
}
