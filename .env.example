# 本文件只定义配置名称，不得填写或提交真实密钥。
# 准确端口、连接串和 Provider 配置由 Slice 0 依据锁定实现补齐。

NODE_ENV=development
APP_TIMEZONE=Asia/Shanghai

# Database — 三套凭据（A4）
# DATABASE_URL: 运行时角色（pw_runtime，非表 owner，用于全部租户业务数据）
# PLATFORM_DATABASE_URL: 平台角色（平台/跨租户管理、审计、平台账号）
# DATABASE_MIGRATION_URL: 迁移角色（表 owner），只用于 prisma migrate/seed 夹具
DATABASE_URL=
PLATFORM_DATABASE_URL=
DATABASE_MIGRATION_URL=

# Redis and queue
REDIS_URL=

# Object storage
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Authentication
SESSION_SECRET=

# PII encryption（A5）
# PII_MASTER_KEY: 32 字节 base64 主密钥；生产环境必填，未配置时拒绝启动。
PII_MASTER_KEY=

# Public application origins
ADMIN_WEB_ORIGIN=
H5_ORIGIN=
API_ORIGIN=

# 报名窗口与无人报名自动关单（P3 / D4）
# DISPATCH_ROUND_WINDOW_MS: 报名窗口毫秒数，默认 600000（10 分钟），允许 60000–7200000
# DISPATCH_NO_APPLICATION_TIMEOUT_MS: 关单窗口，缺省与报名窗口同宽；显式 0 关闭该规则
DISPATCH_ROUND_WINDOW_MS=
DISPATCH_NO_APPLICATION_TIMEOUT_MS=

# Optional providers; production must fail closed when an enabled provider is incomplete.
AI_PROVIDER=
AI_API_KEY=
# 微信登录（公众号网页授权）：WECHAT_LOGIN_ENABLED=true 时下面三项必填，缺任一启动即失败
WECHAT_LOGIN_ENABLED=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_OAUTH_REDIRECT_URI=

# 支付：PAYMENT_PROVIDER 必填（wallet.module.ts 无默认值）；生产用 mock 时必须显式 ALLOW_MOCK_PAYMENT=true
PAYMENT_PROVIDER=
ALLOW_MOCK_PAYMENT=

# SMS（验证码）：SMS_PROVIDER=mock|tencent；tencent 时缺任一 TENCENT_SMS_* 即启动失败
SMS_PROVIDER=
ALLOW_MOCK_SMS=
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=
