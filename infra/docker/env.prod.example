# 生产环境变量模板：不得把真实值提交到 Git。
# 部署时复制为 /srv/pw-saas/.env 并填入随机强密码/密钥。

NODE_ENV=production

# PostgreSQL（docker compose postgres 服务内部）
POSTGRES_USER=pw_saas
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pw_saas
# pw_runtime 迁移后由 ALTER ROLE 设置
PW_RUNTIME_PASSWORD=change-me

# 运行时/平台/迁移三套连接串（容器内 host=postgres）
DATABASE_URL=postgresql://pw_runtime:change-me@postgres:5432/pw_saas?schema=public
PLATFORM_DATABASE_URL=postgresql://pw_saas:change-me@postgres:5432/pw_saas?schema=public
DATABASE_MIGRATION_URL=postgresql://pw_saas:change-me@postgres:5432/pw_saas?schema=public

REDIS_URL=redis://redis:6379/0

# 会话与 PII 加密（PII_MASTER_KEY 为 32 字节 base64；生产必填）
SESSION_SECRET=change-me
PII_MASTER_KEY=change-me

# 公开来源
ADMIN_WEB_ORIGIN=https://admin.17ai.club
H5_ORIGIN=https://h5.17ai.club
NEXT_PUBLIC_API_ORIGIN=https://api.17ai.club
# 新开门店主域名后缀：主域名留空时自动生成 {门店code}.{后缀}
NEXT_PUBLIC_TENANT_HOST_SUFFIX=17ai.club

# 证据文件根目录（容器卷）
EVIDENCE_ROOT=/app/data/evidence

# 支付：真实通道接入前，仅演示模式允许 mock
PAYMENT_PROVIDER=mock
ALLOW_MOCK_PAYMENT=true

# 短信：当前仅实现 mock；生产演示部署必须显式允许，否则 api 启动即失败
# （P2 冒烟实测：缺 ALLOW_MOCK_SMS=true 时容器进入崩溃循环）
SMS_PROVIDER=mock
ALLOW_MOCK_SMS=true

# 真实短信（S2）：SMS_PROVIDER=tencent 时下面各项必填，缺任一项 api / pw-init 启动即失败并点名变量。
# 模板必须是「单变量验证码模板」：腾讯云的 TemplateParamSet 按位置取值，没有参数名字段。
# SignName 全平台用一个签名，不要按门店申请（腾讯云签名有数量与审核成本）。
# TENCENT_SMS_SECRET_ID=
# TENCENT_SMS_SECRET_KEY=
# TENCENT_SMS_SDK_APP_ID=
# TENCENT_SMS_SIGN_NAME=
# TENCENT_SMS_TEMPLATE_ID=
# TENCENT_SMS_REGION=ap-guangzhou

# 后台任务间隔（可选，缺省值即下面这些）
OUTBOX_POLL_MS=5000
ORDER_CONFIRM_TIMEOUT_MS=900000

# 报名窗口（毫秒，默认 600000=10 分钟，允许范围 60000–7200000；非法或越界回退默认）
DISPATCH_ROUND_WINDOW_MS=600000
# 无人报名自动关单窗口（毫秒）：缺省与报名窗口同宽；显式 0 = 关闭该规则
# DISPATCH_NO_APPLICATION_TIMEOUT_MS=600000

# 演示门店初始化（seed-prod.mjs 使用；生产首批演示数据可后续清理）
SEED_TENANT_CODE=demo
SEED_TENANT_NAME=17AI 演示门店
SEED_TENANT_HOSTS=h5.17ai.club
SEED_PLATFORM_PASSWORD=change-me
SEED_TENANT_PASSWORD=change-me
SEED_PLATFORM_USER=admin

# 平台端「一键开店」页展示用的通配域名（可选）
NEXT_PUBLIC_WILDCARD_ROOT=
NEXT_PUBLIC_H5_ORIGIN=https://h5.17ai.club
