{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "lib/**", "build/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"]
    },
    "build:h5": {
      "outputs": ["dist/**"]
    },
    "build:weapp": {
      "outputs": ["dist/**"]
    }
  }
}
