  @@unique([tenantId, orderId])
  @@unique([tenantId, applicationId])
  @@index([tenantId, playerId])
  @@map("assignments")
}

// ===== Slice 7：服务场次与证据（主规格 10.3/11.3/14.1）=====
// 服务器权威时钟核算；session_events/adjustments/evidence 只追加（无 updated_at 或复核不覆盖原始）。

enum SessionStatus {
  SCHEDULED
  STARTED
  ENDED
  CONFIRMED
  ADJUSTMENT_PENDING
}

enum AdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
}

model ServiceSession {
