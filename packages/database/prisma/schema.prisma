model PaymentOrder {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  customerProfileId String    @map("customer_profile_id") @db.Uuid
  outNo             String    @map("out_no")
  amountFen         BigInt    @map("amount_fen") @db.BigInt
  provider          String    @default("mock")
  providerRef       String?   @map("provider_ref")
  /// S4：服务商模式下的商户标识（下单时写入，便于对账与排障）
  spMchid           String?   @map("sp_mchid")
  subMchid          String?   @map("sub_mchid")
  prepayId          String?   @map("prepay_id")
  transactionId     String?   @map("transaction_id")
  /// payer 标识（sp_openid）：属个人信息，加密存储，明文不落库、不进日志
  payerOpenidEnc    String?   @map("payer_openid_enc")
  paidAt            DateTime? @map("paid_at") @db.Timestamptz
  status            String    @default("PENDING")
  createdAt         DateTime  @default(now()) @map("created_at")
