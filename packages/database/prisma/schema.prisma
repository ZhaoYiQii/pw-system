// 陪玩门店多租户 SaaS — 主规格 v1.0
// Slice 1：租户开通与隔离（平台层表 + 租户域名/App 绑定）
// 命名契约见主规格第 11 章：所有租户业务表带 tenant_id、created_at、updated_at、version；
// 不可变事件表不含 updated_at（后续切片）。金额使用整数分，禁止浮点（后续切片）。

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  INACTIVE
  CONFIG_ERROR
}

/// 平台层表：SaaS 运营方维护的租户注册表；用于 host/短码解析，不属于单个租户的数据，
/// 故不启用租户级 RLS（H5 预认证解析必须能跨租户读取 code/host）。
model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  code      String       @unique
  name      String
  status    TenantStatus @default(ACTIVE)
  timezone  String       @default("Asia/Shanghai")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  version   Int          @default(1)

  domains     TenantDomain[]
  appBindings TenantAppBinding[]

  @@map("tenants")
}

/// 租户域名绑定：租户级资源，启用 RLS（按 tenant_id）。
model TenantDomain {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  host      String
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, host])
  @@index([tenantId])
  @@map("tenant_domains")
}

/// 租户小程序 AppID 绑定：租户级资源，启用 RLS（按 tenant_id）。小程序开发暂缓，仅建结构。
model TenantAppBinding {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  appId     String   @map("app_id")
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([appId])
  @@index([tenantId])
  @@map("tenant_app_bindings")
}
