// 陪玩门店多租户 SaaS — 主规格 v1.0
// Slice 1：租户开通与隔离（平台层表 + 租户域名/App 绑定）
// 命名契约见主规格第 11 章：所有租户业务表带 tenant_id、created_at、updated_at、version；
// 不可变事件表不含 updated_at（后续切片）。金额使用整数分，禁止浮点（后续切片）。

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  INACTIVE
  CONFIG_ERROR
}

/// 平台层表：SaaS 运营方维护的租户注册表；用于 host/短码解析，不属于单个租户的数据，
/// 故不启用租户级 RLS（H5 预认证解析必须能跨租户读取 code/host）。
model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  code      String       @unique
  name      String
  status    TenantStatus @default(ACTIVE)
  timezone  String       @default("Asia/Shanghai")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  version   Int          @default(1)

  domains      TenantDomain[]
  appBindings  TenantAppBinding[]
  accounts      TenantAccount[]
  accountRoles  TenantAccountRole[]
  configVersions TenantConfigVersion[]
  entitlements   TenantEntitlement[]

  @@map("tenants")
}

/// 租户域名绑定：租户级资源，启用 RLS（按 tenant_id）。
model TenantDomain {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  host      String
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, host])
  @@index([tenantId])
  @@map("tenant_domains")
}

/// 租户小程序 AppID 绑定：租户级资源，启用 RLS（按 tenant_id）。小程序开发暂缓，仅建结构。
model TenantAppBinding {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  appId     String   @map("app_id")
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([appId])
  @@index([tenantId])
  @@map("tenant_app_bindings")
}

// ===== Slice 2：身份、会话与 RBAC（主规格 7/11.2/11.4/16.1）=====

enum AccountStatus {
  ACTIVE
  DISABLED
}

enum RoleKey {
  PLATFORM_SUPER_ADMIN
  PLATFORM_SUPPORT
  TENANT_OWNER
  TENANT_ADMIN
  CUSTOMER_SERVICE
  FINANCE
  PLAYER
  CUSTOMER
}

/// 平台账号（SaaS 运营方）。平台级，不启用租户 RLS；运行时角色无权限读取（迁移2 显式 revoke）。
model PlatformAccount {
  id           String        @id @default(uuid()) @db.Uuid
  username     String        @unique
  passwordHash String        @map("password_hash")
  status       AccountStatus @default(ACTIVE)
  role         RoleKey
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  version      Int           @default(1)

  @@map("platform_accounts")
}

/// 门店账号（店员/陪玩/客户）。租户级资源，启用 RLS（按 tenant_id）。
model TenantAccount {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  username     String
  passwordHash String        @map("password_hash")
  status       AccountStatus @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  version      Int           @default(1)

  tenant Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  roles  TenantAccountRole[]

  @@unique([tenantId, username])
  @@index([tenantId])
  @@map("tenant_accounts")
}

/// 门店账号-角色。租户级资源，启用 RLS。
model TenantAccountRole {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  tenantAccountId String       @map("tenant_account_id") @db.Uuid
  role            RoleKey
  createdAt       DateTime     @default(now()) @map("created_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  tenantAccount TenantAccount  @relation(fields: [tenantAccountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, tenantAccountId, role])
  @@index([tenantAccountId])
  @@map("tenant_account_roles")
}

/// 刷新会话（旋转式）。非租户业务表：含哈希令牌，不启用 RLS；运行时角色可读写（登录/刷新流程）。
model RefreshSession {
  id          String    @id @default(uuid()) @db.Uuid
  subjectType String    @map("subject_type")
  accountId   String    @map("account_id") @db.Uuid
  tenantId    String?   @map("tenant_id") @db.Uuid
  tokenHash   String    @map("token_hash") @unique
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  revokedAt   DateTime? @map("revoked_at")

  @@index([subjectType, accountId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}
// ===== Slice 3：门店配置与套餐功能开关（主规格 8.3/9/11.1）=====

enum ConfigVersionStatus {
  ACTIVE
  SUPERSEDED
  CONFIG_ERROR
}

/// 门店配置版本（tenant-config v1，JSON 由 @pw/config-schema 校验）。租户级 RLS。
model TenantConfigVersion {
  id        String               @id @default(uuid()) @db.Uuid
  tenantId  String               @map("tenant_id") @db.Uuid
  version   Int
  config    Json
  status    ConfigVersionStatus  @default(ACTIVE)
  createdBy String?              @map("created_by") @db.Uuid
  createdAt DateTime             @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, version])
  @@index([tenantId, status])
  @@map("tenant_config_versions")
}

/// 租户功能开关（addon 默认关闭；core 常开不入表）。租户级 RLS。
model TenantEntitlement {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  featureKey String   @map("feature_key")
  enabled    Boolean  @default(false)
  source     String   @default("platform")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  version    Int      @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, featureKey])
  @@index([tenantId])
  @@map("tenant_entitlements")
}

// ===== Slice 4：客户、陪玩与服务目录（主规格 11.2/10.5/8.2）=====
// 金额一律 bigint 分（MoneyFen）；时长整数秒（DurationSeconds）。租户业务表带 tenant_id，启用 RLS。
// 注：外键由迁移 SQL 建立（含 DB CHECK/RLS）；此处仅声明列，不声明 Prisma 关系字段，避免反向数组噪音。

enum ActiveStatus {
  ACTIVE
  INACTIVE
}

model CustomerProfile {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  tenantAccountId String?      @map("tenant_account_id") @db.Uuid
  name            String
  mobile    String?
  remark    String?
  status    ActiveStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  version   Int          @default(1)

  @@unique([tenantId, mobile])
  @@unique([tenantId, tenantAccountId])
  @@index([tenantId])
  @@map("customer_profiles")
}

model PlayerProfile {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  tenantAccountId String?      @map("tenant_account_id") @db.Uuid
  name            String
  mobile          String?
  intro           String?
  status          ActiveStatus @default(ACTIVE)
  acceptingOrders Boolean      @default(true) @map("accepting_orders")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  version         Int          @default(1)

  @@unique([tenantId, mobile])
  @@unique([tenantId, tenantAccountId])
  @@index([tenantId])
  @@map("player_profiles")
}

model Game {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  name      String
  enabled   Boolean      @default(true)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  version   Int          @default(1)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("games")
}

model GameRegion {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  gameId    String   @map("game_id") @db.Uuid
  name      String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(1)

  @@unique([tenantId, gameId, name])
  @@index([tenantId, gameId])
  @@map("game_regions")
}

model ServiceProduct {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  gameId        String       @map("game_id") @db.Uuid
  gameRegionId  String?      @map("game_region_id") @db.Uuid
  name          String
  description   String?
  enabled       Boolean      @default(true)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  version       Int          @default(1)

  @@unique([tenantId, gameId, name])
  @@index([tenantId, gameId])
  @@index([tenantId, gameRegionId])
  @@map("service_products")
}

model PricingRule {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  serviceProductId  String    @map("service_product_id") @db.Uuid
  durationSeconds   Int       @map("duration_seconds")
  priceFen          BigInt    @map("price_fen") @db.BigInt
  playerCostFen     BigInt    @default(0) @map("player_cost_fen") @db.BigInt
  enabled           Boolean   @default(true)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  version           Int       @default(1)

  @@unique([tenantId, serviceProductId, durationSeconds])
  @@index([tenantId, serviceProductId])
  @@map("pricing_rules")
}

model PlayerSkill {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  playerId     String   @map("player_id") @db.Uuid
  gameId       String   @map("game_id") @db.Uuid
  gameRegionId String?  @map("game_region_id") @db.Uuid
  title        String?
  note         String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  version      Int      @default(1)

  @@unique([tenantId, playerId, gameId])
  @@index([tenantId, playerId])
  @@index([tenantId, gameId])
  @@map("player_skills")
}

model PlayerAvailability {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  playerId  String   @map("player_id") @db.Uuid
  startsAt  DateTime @map("starts_at") @db.Timestamptz
  endsAt    DateTime @map("ends_at") @db.Timestamptz
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(1)

  @@index([tenantId, playerId, startsAt])
  @@map("player_availability")
}
// ===== Slice 5：需求确认与订单（主规格 10.1/11.3-11.5/12.1/14.2）=====
// 状态机唯一入口写入 order_events；order_price_snapshots/order_events 不可变（无 updated_at）。
// outbox_events 与业务写入同事务；idempotency_records 支持 Idempotency-Key。

enum OrderStatus {
  DRAFT
  CONFIRMED
  DISPATCHING
  ASSIGNED
  READY
  IN_PROGRESS
  PENDING_CONFIRMATION
  COMPLETED
  CANCELLED
}

model Order {
  id                 String      @id @default(uuid()) @db.Uuid
  tenantId           String      @map("tenant_id") @db.Uuid
  orderNo            String      @map("order_no")
  customerProfileId  String      @map("customer_profile_id") @db.Uuid
  scheduledStartAt   DateTime?   @map("scheduled_start_at") @db.Timestamptz
  status             OrderStatus @default(DRAFT)
  remark             String?
  version            Int         @default(1)
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  @@unique([tenantId, orderNo])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, customerProfileId, createdAt])
  @@map("orders")
}

model OrderRequirement {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  orderId          String   @map("order_id") @db.Uuid
  gameId           String?  @map("game_id") @db.Uuid
  serviceProductId String?  @map("service_product_id") @db.Uuid
  gender           String?
  description      String
  desiredStartAt   DateTime? @map("desired_start_at") @db.Timestamptz
  durationSeconds  Int?     @map("duration_seconds")
  minBudgetFen     BigInt?  @map("min_budget_fen") @db.BigInt
  maxBudgetFen     BigInt?  @map("max_budget_fen") @db.BigInt
  note             String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  version          Int      @default(1)

  @@unique([tenantId, orderId])
  @@index([tenantId, orderId])
  @@map("order_requirements")
}

/// 价格快照不可变：确认订单时按当时产品/价格生成，禁止改历史。
model OrderPriceSnapshot {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  orderId          String   @map("order_id") @db.Uuid
  snapshotVersion  Int      @map("snapshot_version")
  serviceProductId String?  @map("service_product_id") @db.Uuid
  productName      String   @map("product_name")
  regionName       String?  @map("region_name")
  durationSeconds  Int      @map("duration_seconds")
  unitPriceFen     BigInt   @map("unit_price_fen") @db.BigInt
  playerCostFen    BigInt   @default(0) @map("player_cost_fen") @db.BigInt
  quantity         Int      @default(1)
  lineTotalFen     BigInt   @map("line_total_fen") @db.BigInt
  currency         String   @default("CNY")
  generatedAt      DateTime @default(now()) @map("generated_at")

  @@unique([tenantId, orderId, snapshotVersion, serviceProductId])
  @@index([tenantId, orderId])
  @@map("order_price_snapshots")
}

/// 订单事件（不可变，仅追加）。状态迁移唯一入口写入。
model OrderEvent {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  orderId    String   @map("order_id") @db.Uuid
  eventType  String   @map("event_type")
  fromStatus String?  @map("from_status")
  toStatus   String?  @map("to_status")
  actorType  String?  @map("actor_type")
  actorId    String?  @map("actor_id") @db.Uuid
  payload    Json     @default("{}")
  occurredAt DateTime @default(now()) @map("occurred_at")

  @@index([tenantId, orderId, occurredAt])
  @@map("order_events")
}

/// Outbox：业务事务内写入，Worker 提交后消费（幂等按 eventId/aggregateId）。
model OutboxEvent {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String?  @map("tenant_id") @db.Uuid
  aggregateType String   @map("aggregate_type")
  aggregateId   String   @map("aggregate_id")
  eventType     String   @map("event_type")
  payload       Json     @default("{}")
  status        String   @default("PENDING")
  availableAt   DateTime @default(now()) @map("available_at")
  attempts      Int      @default(0)
  lastError     String?  @map("last_error")
  processedAt   DateTime? @map("processed_at") @db.Timestamptz
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([status, availableAt])
  @@map("outbox_events")
}

/// 幂等记录：写接口重复提交返回同一业务结果。
model IdempotencyRecord {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  idempotencyKey String   @map("idempotency_key")
  operation     String
  entityType    String?  @map("entity_type")
  entityId      String?  @map("entity_id")
  responseJson  Json?    @map("response_json")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([tenantId, idempotencyKey, operation])
  @@index([tenantId, entityType, entityId])
  @@map("idempotency_records")
}