// 金额一律 bigint 分 CNY；ledger 只追加（无 updated_at）；批次 DRAFT→REVIEWED→APPROVED→PAID/VOID。

enum Direction {
  DEBIT
  CREDIT
}

enum EarningStatus {
  PENDING
  BATCHED
  PAID
}

enum BatchStatus {
  DRAFT
  REVIEWED
  APPROVED
  PAID
  VOID
}

model LedgerAccount {
  id        String   @id @default(uuid()) @db.Uuid
